# Opcional: domínio público do app; na Vercel, usa o domínio de produção automaticamente.
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cron da Vercel (envia Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Exportação para Google Sheets (service account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Chave privada em uma linha, com \n escapado
GOOGLE_PRIVATE_KEY=

# Feature flags (padrão: desativado)
NEXT_PUBLIC_SIGNUP_ENABLED=false
NEXT_PUBLIC_SHEETS_ENABLED=false
